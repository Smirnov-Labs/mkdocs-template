# GitLab Pages deployment for the docs site.
# Rename this file to .gitlab-ci.yml (or merge into your existing pipeline).
# Adjust the branch name in `rules` to match your default branch.

pages:
  stage: deploy
  image: python:3.12-slim
  script:
    - cd docs
    - pip install -r requirements.txt
    - mkdocs build -f mkdocs.yml
    - mv site ../public
  artifacts:
    paths:
      - public
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes:
        - docs/**/*
        - .gitlab-ci.yml
